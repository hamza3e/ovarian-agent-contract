{
  "$defs": {
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "description": "Text the agent cites as evidence, as produced by the agent.",
          "title": "Quote",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Char offset in the source, set by the verifier.",
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "match_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fuzzy match score 0-100.",
          "title": "Match Score"
        },
        "verified": {
          "default": false,
          "description": "True only if code located the quote in the source.",
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "quote"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "FieldResult": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "confidence_raw": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Raw"
        },
        "confidence_calibrated": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Calibrated"
        },
        "prediction_set": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Conformal prediction set (categorical fields), if computed.",
          "title": "Prediction Set"
        },
        "abstain_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstain Reason"
        }
      },
      "required": [
        "field",
        "status"
      ],
      "title": "FieldResult",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "agent_name": {
          "title": "Agent Name",
          "type": "string"
        },
        "agent_version": {
          "title": "Agent Version",
          "type": "string"
        },
        "contract_version": {
          "default": "0.1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pinned model id incl. revision, if any.",
          "title": "Model Id"
        },
        "prompt_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Sha256"
        },
        "input_sha256": {
          "title": "Input Sha256",
          "type": "string"
        },
        "code_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code Commit"
        },
        "created_utc": {
          "title": "Created Utc",
          "type": "string"
        }
      },
      "required": [
        "agent_name",
        "agent_version",
        "input_sha256"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Status": {
      "enum": [
        "answered",
        "not_stated",
        "abstained"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "site_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Site Id"
    },
    "modality": {
      "enum": [
        "pathology_report",
        "registry",
        "imaging",
        "genomics",
        "clinical_text"
      ],
      "title": "Modality",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldResult"
      },
      "title": "Fields",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "modality",
    "fields",
    "provenance"
  ],
  "title": "AgentOutput v0.1.0",
  "type": "object",
  "$id": "https://github.com/hamza3e/ovarian-agent-contract/contract/agent_output-0.1.0.json"
}
